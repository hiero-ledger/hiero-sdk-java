OPERATOR_KEY="<PRIVATE_KEY>"
OPERATOR_ID="<ACCOUNT_ID>"
HEDERA_NETWORK="<localhost|testnet|previewnet|mainnet>"
SDK_LOG_LEVEL="<TRACE|DEBUG|INFO|WARN|ERROR|SILENT>"

# CLPR (HIP-1535) examples. CLPR is off by default; the network needs clpr.enabled=true.
# Treasury or system admin account, for closing Channels and updating the configuration.
GENESIS_OPERATOR_ID="<ACCOUNT_ID>"
GENESIS_OPERATOR_KEY="<PRIVATE_KEY>"
# Channel ID: exactly 64 hex characters, without 0x.
CLPR_CHANNEL_ID="<CHANNEL_ID_HEX>"
# Ownership private key for Channel or Connector completion. Keep it private.
CLPR_OWNERSHIP_KEY="<PRIVATE_KEY>"
# Deployed verifier contract and real binary peer-ledger proof files.
CLPR_VERIFIER_CONTRACT_ID="<CONTRACT_ID>"
CLPR_CONFIG_PROOF_FILE="<PATH>"
CLPR_MANIFEST_PROOF_FILE="<PATH>"
# Deployed Connector contract, Connector admin private key, and stake meeting clpr.minLockedStake.
CLPR_CONNECTOR_CONTRACT_ID="<CONTRACT_ID>"
CLPR_CONNECTOR_ADMIN_KEY="<PRIVATE_KEY>"
CLPR_LOCKED_STAKE_TINYBARS="<TINYBARS>"
# Positive uint32 limit for the read-modify-write throttle example.
CLPR_MAX_MESSAGES_PER_BUNDLE="<LIMIT>"
